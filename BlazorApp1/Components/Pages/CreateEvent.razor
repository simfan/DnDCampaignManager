@page "/events/create"
@rendermode InteractiveServer
@using BlazorApp1.DTOs
@using BlazorApp1.Services
@using Microsoft.AspNetCore.Authorization
@inject PlayerEventService EventService
@inject CampaignService CampaignService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Create Event</PageTitle>

<div class="container mt-4">
    <div class="mb-4">
        <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back to Hub
        </button>

        <h1>Create New Event</h1>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="newEvent" OnValidSubmit="CreateNewEvent">
            <DataAnnotationsValidator />

            <div class="row">
                <div class="col-md-8">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5>Event Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Event Title *</label>
                                <InputText class="form-control" @bind-Value="newEvent.Title" placeholder="e.g., Weekly Session, One-Shot Adventure" />
                                <ValidationMessage For="@(() => newEvent.Title)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="newEvent.Description" placeholder="Event details, notes, or agenda..." />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Event Date *</label>
                                    <InputDate class="form-control" @bind-Value="newEvent.EventDate" />
                                    <ValidationMessage For="@(() => newEvent.EventDate)" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Campaign (Optional)</label>
                                    <InputSelect class="form-control" @bind-Value="newEvent.CampaignId">
                                        <option value="">-- No Campaign --</option>
                                        @foreach (var campaign in availableCampaigns)
                                        {
                                            <option value="@campaign.CampaignId">@campaign.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Start Time (Optional)</label>
                                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="startTime" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">End Time (Optional)</label>
                                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="endTime" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Create Event
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">
                            Cancel
                        </button>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Preview</h6>
                        </div>
                        <div class="card-body">
                            <h6>@(string.IsNullOrWhiteSpace(newEvent.Title) ? "Event Title" : newEvent.Title)</h6>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-calendar"></i> @newEvent.EventDate.ToString("MMMM dd, yyyy")
                            </p>
                            @if (startTime.HasValue)
                            {
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-clock"></i>
                                    @startTime.Value.ToString("hh:mm tt")
                                    @if (endTime.HasValue)
                                    {
                                        <text> - @endTime.Value.ToString("hh:mm tt")</text>
                                    }
                                </p>
                            }
                            @if (newEvent.CampaignId.HasValue)
                            {
                                var campaign = availableCampaigns.FirstOrDefault(c => c.CampaignId == newEvent.CampaignId.Value);
                                if (campaign != null)
                                {
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-map"></i> @campaign.Name
                                    </p>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(newEvent.Description))
                            {
                                <hr />
                                <p class="small">@newEvent.Description</p>
                            }
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-body">
                            <h6 class="card-title">Tips</h6>
                            <ul class="small mb-0">
                                <li>Events can be linked to a campaign or kept general</li>
                                <li>Times are optional but helpful for scheduling</li>
                                <li>Events will appear on your calendar</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    private CreatePlayerEventDto newEvent = new() { EventDate = DateTime.Today };
    private List<CampaignDto> availableCampaigns = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private DateTime? startTime;
    private DateTime? endTime;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            availableCampaigns = await CampaignService.GetCampaignsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateNewEvent()
    {
        isSaving = true;
        try
        {
            // Convert DateTime? to TimeSpan? for times
            if (startTime.HasValue)
            {
                newEvent.StartTime = startTime.Value.TimeOfDay;
            }
            if (endTime.HasValue)
            {
                newEvent.EndTime = endTime.Value.TimeOfDay;
            }

            var created = await EventService.CreateEventAsync(newEvent);

            if (created != null)
            {
                Navigation.NavigateTo("/");
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
