@page "/campaigns"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.DTOs
@using BlazorApp1.Services
@using BlazorStrap
@using BlazorStrap.V5
@inject CampaignService CampaignService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>My Campaigns</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Campaigns</h1>
        <button class="btn btn-primary" @onclick="ShowCreateModal">
            <i class="bi bi-plus-circle"></i> Create Campaign
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (campaigns.Count == 0)
    {
        <div class="alert alert-info">
            <p>You haven't joined any campaigns yet. Create one to get started!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var campaign in campaigns)
            {
                <!--<BSCard CardType="CardType.Card">
                    <BSCard CardType="CardType.Header">
                        @campaign.Name
                    </BSCard>
                    <BSCard CardType="CardType.Body">
                        @campaign.Description
                    </BSCard>
                </BSCard>-->
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100" style="cursor: pointer;" @onclick="() => ViewCampaign(campaign.CampaignId)">
                        <div class="card-body">
                            <h5 class="card-title">@campaign.Name</h5>
                            <p class="card-text text-muted">@campaign.Description</p>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-people"></i> @campaign.MemberCount members
                                    <br />
                                    <i class="bi bi-person"></i> @campaign.CharacterCount characters
                                    <br />
                                    <i class="bi bi-shield"></i> DM: @campaign.CreatedByName
                                </small>
                            </div>
                            @if (!campaign.IsActive)
                            {
                                <span class="badge bg-secondary mt-2">Inactive</span>
                            }
                        </div>
                        <div class="card-footer">
                            <small class="text-muted">Created @campaign.CreatedDate.ToShortDateString()</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Create Campaign Modal *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Campaign</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Campaign Name</label>
                        <input type="text" class="form-control" @bind="newCampaign.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="3" @bind="newCampaign.Description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateCampaign">Create</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CampaignDto> campaigns = new();
    private bool isLoading = true;
    private bool showCreateModal = false;
    private CreateCampaignDto newCampaign = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCampaigns();
    }

    private async Task LoadCampaigns()
    {
        isLoading = true;
        try
        {
            campaigns = await CampaignService.GetCampaignsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        newCampaign = new CreateCampaignDto();
        showCreateModal = true;
    }

    private void HideCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreateCampaign()
    {
        if (string.IsNullOrWhiteSpace(newCampaign.Name))
            return;

        await CampaignService.CreateCampaignAsync(newCampaign);
        HideCreateModal();
        await LoadCampaigns();
    }

    private void ViewCampaign(int campaignId)
    {
        Navigation.NavigateTo($"/campaigns/{campaignId}");
    }
}