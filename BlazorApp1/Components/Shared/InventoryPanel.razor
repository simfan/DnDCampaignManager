@using BlazorApp1.DTOs
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject InventoryService InventoryService
@inject DiceService DiceService

<div class="inventory-panel">
    @if (isLoading)
    {
        <div class="text-center py-3">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="ms-2">Loading inventory...</span>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">
                @items.Count item(s) &nbsp;|&nbsp;
                @*Total weight: @(items.Sum(i => (i.Weight ?? 0) * i.Quantity):F1) lb &nbsp;|&nbsp;
                Total value: @(items.Sum(i => (i.Value ?? 0) * i.Quantity):F1) gp*@
            </span>
            <button class="btn btn-sm btn-primary" @onclick="ShowAddModal">
                <i class="bi bi-plus-circle"></i> Add Item
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible">
                @errorMessage
                <button type="button" class="btn-close" @onclick='() => errorMessage = null'></button>
            </div>
        }

        @if (items.Count == 0)
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-bag" style="font-size: 2rem;"></i>
                <p class="mt-2">No items yet. Add one above!</p>
            </div>
        }
        else
        {
            @foreach (var group in items.GroupBy(i => i.ItemType).OrderBy(g => g.Key))
            {
                <h6 class="text-muted mt-3 mb-1 border-bottom pb-1">
                    <i class="bi @ItemTypeIcon(group.Key)"></i> @group.Key
                </h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Details</th>
                                <th style="width:55px" class="text-center">Qty</th>
                                <th style="width:65px" class="text-center">Weight</th>
                                <th style="width:65px" class="text-center">Value</th>
                                <th style="width:150px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group.OrderBy(i => i.Name))
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.Name</span>
                                        @if (item.IsEquipped)
                                        {
                                            <span class="badge bg-success ms-1" style="font-size:.65rem;">Equipped</span>
                                        }
                                        @if (item.ItemType == ItemType.MagicItem && item.IsAttuned == true)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" style="font-size:.65rem;">Attuned</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <br />
                        
                                            <small class="text-muted">@item.Description</small>
                                        }
                                    </td>
                                    <td><small class="text-muted">@ItemSummary(item)</small></td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-center">@(item.Weight.HasValue ? $"{item.Weight:F1}" : "–")</td>
                                    <td class="text-center">@(item.Value.HasValue ? $"{item.Value:F1}gp" : "–")</td>
                                    <td class="text-end">
                                        @if (item.ItemType == ItemType.Weapon && CharacterId.HasValue)
                                        {
                                            <button class="btn btn-outline-danger btn-sm me-1" title="Roll Attack"
                                                    @onclick="() => RollWeaponAttack(item)">
                                                <i class="bi bi-dice-5"></i>
                                            </button>
                                            /*<button class "btn btn-outline-danger btn-sm me-1" title=" = "Roll Damage"
                                            @onclick="() => RollWeaponDamage()"></button>*/
                                        }
                                        <button class="btn btn-outline-secondary btn-sm me-1" title="Edit"
                                                @onclick="() => ShowEditModal(item)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (TransferDestinations.Any())
                                        {
                                            <button class="btn btn-outline-info btn-sm me-1" title="Transfer"
                                                    @onclick="() => ShowTransferModal(item)">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        }
                                        <button class="btn btn-outline-danger btn-sm" title="Delete"
                                                @onclick="() => DeleteItem(item)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@* ── Add / Edit Modal ────────────────────────────────────────────────────── *@
@if (showItemModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingItem == null ? "Add Item" : "Edit Item")</h5>
                    <button type="button" class="btn-close" @onclick="CloseItemModal"></button>
                </div>
                <div class="modal-body">

                    @* ── Common fields ── *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Item Type *</label>
                            <select class="form-select" @bind="form.ItemType">
                                @foreach (var t in Enum.GetValues<ItemType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Name *</label>
                            <input class="form-control" @bind="form.Name" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label">Quantity</label>
                            <input type="number" class="form-control" min="1" @bind="form.Quantity" />
                        </div>
                        <div class="col">
                            <label class="form-label">Weight (lb)</label>
                            <input type="number" step="0.1" class="form-control" @bind="form.Weight" />
                        </div>
                        <div class="col">
                            <label class="form-label">Value (gp)</label>
                            <input type="number" step="0.01" class="form-control" @bind="form.Value" />
                        </div>
                        @if (CharacterId.HasValue)
                        {
                            <div class="col-auto d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="form.IsEquipped" />
                                    <label class="form-check-label">Equipped</label>
                                </div>
                            </div>
                        }
                    </div>

                    <hr />

                    @* ── Weapon fields ── *@
                    @if (form.ItemType == ItemType.Weapon)
                    {
                        <h6>Weapon Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Attack Type</label>
                                <select class="form-select" @bind="form.AttackType">
                                    @foreach (var v in Enum.GetValues<WeaponAttackType>())
                                    {
                                        <option value="@v">@v</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ability Used</label>
                                <select class="form-select" @bind="form.AbilityUsed">
                                    <option value="@WeaponAbility.STR">STR</option>
                                    <option value="@WeaponAbility.DEX">DEX</option>
                                    <option value="@WeaponAbility.STRorDEX">STR or DEX (Finesse)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Damage Type</label>
                                <select class="form-select" @bind="form.DamageType">
                                    @foreach (var v in Enum.GetValues<DamageType>())
                                    {
                                        <option value="@v">@v</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-3">
                                <label class="form-label">Damage Dice</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" min="1" @bind="form.DamageDiceCount" placeholder="1" />
                                    <span class="input-group-text">d</span>
                                    <select class="form-select" @bind="form.DamageDiceSides">
                                        @foreach (var s in new[] { 4, 6, 8, 10, 12, 20 })
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-2">
                                <label class="form-label">Bonus</label>
                                <input type="number" class="form-control" @bind="form.DamageBonus" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Versatile Dice</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" min="1" @bind="form.VersatileDiceCount" placeholder="–" />
                                    <span class="input-group-text">d</span>
                                    <select class="form-select" @bind="form.VersatileDiceSides">
                                        <option value="">–</option>
                                        @foreach (var s in new[] { 4, 6, 8, 10, 12, 20 })
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-2">
                                <label class="form-label">Reach (ft)</label>
                                <input type="number" class="form-control" @bind="form.ReachFt" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-3">
                                <label class="form-label">Range Normal (ft)</label>
                                <input type="number" class="form-control" @bind="form.RangeNormalFt" placeholder="–" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Range Long (ft)</label>
                                <input type="number" class="form-control" @bind="form.RangeLongFt" placeholder="–" />
                            </div>
                        </div>
                        <div class="row g-3 mb-2">
                            <div class="col-auto">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="form.IsTwoHanded" />
                                    <label class="form-check-label">Two-Handed</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="form.IsLight" />
                                    <label class="form-check-label">Light</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="form.IsThrown" />
                                    <label class="form-check-label">Thrown</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Additional Properties</label>
                            <input class="form-control" @bind="form.Properties" placeholder="e.g. Loading, Special, Silvered" />
                        </div>
                    }

                    @* ── Armor fields ── *@
                    @if (form.ItemType == ItemType.Armor)
                    {
                        <h6>Armor Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-3">
                                <label class="form-label">Armor Type</label>
                                <select class="form-select" @bind="form.ArmorType">
                                    @foreach (var v in Enum.GetValues<ArmorType>())
                                    {
                                        <option value="@v">@v</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Base AC</label>
                                <input type="number" class="form-control" @bind="form.BaseArmorClass" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">AC Bonus</label>
                                <input type="number" class="form-control" @bind="form.ArmorClassBonus" placeholder="0" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Max DEX Bonus</label>
                                <input type="number" class="form-control" @bind="form.MaxDexBonus" placeholder="Unlimited" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">STR Requirement</label>
                                <input type="number" class="form-control" @bind="form.StrengthRequirement" placeholder="–" />
                            </div>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="form.StealthDisadvantage" />
                            <label class="form-check-label">Stealth Disadvantage</label>
                        </div>
                    }

                    @* ── Magic Item fields ── *@
                    @if (form.ItemType == ItemType.MagicItem)
                    {
                        <h6>Magic Item Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Rarity</label>
                                <select class="form-select" @bind="form.Rarity">
                                    @foreach (var v in Enum.GetValues<ItemRarity>())
                                    {
                                        <option value="@v">@v</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Max Charges</label>
                                <input type="number" class="form-control" @bind="form.MaxCharges" placeholder="–" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Current Charges</label>
                                <input type="number" class="form-control" @bind="form.CurrentCharges" placeholder="–" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-auto">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="form.RequiresAttunement" />
                                    <label class="form-check-label">Requires Attunement</label>
                                </div>
                            </div>
                            @if (form.RequiresAttunement == true)
                            {
                                <div class="col-auto">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="form.IsAttuned" />
                                        <label class="form-check-label">Currently Attuned</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Effect</label>
                            <textarea class="form-control" rows="2" @bind="form.Effect"></textarea>
                        </div>
                    }

                    @* ── Potion fields ── *@
                    @if (form.ItemType == ItemType.Potion)
                    {
                        <h6>Potion Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Effect</label>
                                <input class="form-control" @bind="form.Effect" placeholder="e.g. Restores HP, grants darkvision" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Duration</label>
                                <input class="form-control" @bind="form.Duration" placeholder="e.g. 1 hour, Instantaneous" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-auto">
                                <label class="form-label">Healing Dice</label>
                                <div class="input-group" style="width:180px">
                                    <input type="number" class="form-control" min="1" @bind="form.HealDiceCount" placeholder="–" />
                                    <span class="input-group-text">d</span>
                                    <select class="form-select" @bind="form.HealDiceSides">
                                        <option value="">–</option>
                                        @foreach (var s in new[] { 4, 6, 8, 10, 12 })
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label class="form-label">Heal Bonus</label>
                                <input type="number" class="form-control" style="width:90px" @bind="form.HealBonus" placeholder="0" />
                            </div>
                        </div>
                    }

                    @* ── Ammunition fields ── *@
                    @if (form.ItemType == ItemType.Ammunition)
                    {
                        <h6>Ammunition Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Ammunition Type</label>
                                <input class="form-control" @bind="form.AmmunitionType" placeholder="e.g. Arrow, Bolt, Bullet" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Damage Bonus Override</label>
                                <input type="number" class="form-control" @bind="form.DamageBonusOverride" placeholder="e.g. +1" />
                            </div>
                        </div>
                    }

                    @* ── Tool fields ── *@
                    @if (form.ItemType == ItemType.Tool)
                    {
                        <h6>Tool Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-5">
                                <label class="form-label">Tool Type</label>
                                <input class="form-control" @bind="form.ToolType" placeholder="e.g. Thieves' Tools, Smith's Tools" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Associated Skill</label>
                                <input class="form-control" @bind="form.AssociatedSkill" placeholder="e.g. Stealth, Perception" />
                            </div>
                            <div class="col-auto d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" @bind="form.HasProficiency" />
                                    <label class="form-check-label">Proficient</label>
                                </div>
                            </div>
                        </div>
                    }

                    @* ── Mount fields ── *@
                    @if (form.ItemType == ItemType.Mount)
                    {
                        <h6>Mount / Vehicle Properties</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Mount Type</label>
                                <input class="form-control" @bind="form.MountType" placeholder="e.g. Warhorse, Rowboat" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Speed (ft)</label>
                                <input type="number" class="form-control" @bind="form.SpeedFt" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Carrying Capacity</label>
                                <input class="form-control" @bind="form.CarryingCapacity" placeholder="e.g. 480 lb" />
                            </div>
                        </div>
                    }

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseItemModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveItem" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Transfer Modal ────────────────────────────────────────────────────────── *@
@if (showTransferModal && transferItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-left-right"></i> Transfer "@transferItem.Name"
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseTransferModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Send to</label>
                        <select class="form-select" @bind="selectedDestinationKey">
                            <option value="">— Choose destination —</option>
                            @foreach (var dest in TransferDestinations)
                            {
                                <option value="@dest.Key">@dest.Label</option>
                            }
                        </select>
                    </div>
                    @if (transferItem.Quantity > 1)
                    {
                        <div class="mb-3">
                            <label class="form-label">Quantity to transfer (max @transferItem.Quantity)</label>
                            <input type="number" class="form-control" min="1" max="@transferItem.Quantity"
                                   @bind="transferQuantity" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseTransferModal">Cancel</button>
                    <button class="btn btn-info text-white" @onclick="DoTransfer"
                            disabled="@(isSaving || string.IsNullOrEmpty(selectedDestinationKey))">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Transfer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter] public int? CharacterId { get; set; }
    [Parameter] public int? CampaignId { get; set; }
    [Parameter] public List<CharacterDto> PartyCharacters { get; set; } = new();

    /// <summary>
    /// Fired when a weapon attack or damage roll is made, so the parent page
    /// can display the result in its "Last Roll" card.
    /// </summary>
    [Parameter] public EventCallback<DiceRoll> OnRoll { get; set; }

    [Parameter] public EventCallback OnTransferred { get; set; }

    // ── Transfer destinations ─────────────────────────────────────────────────

    private record TransferDestination(string Key, string Label, int? ToCharacterId, int? ToCampaignId);

    private List<TransferDestination> TransferDestinations
    {
        get
        {
            var list = new List<TransferDestination>();
            if (CharacterId.HasValue && CampaignId.HasValue)
                list.Add(new("campaign", "Party Chest", null, CampaignId));
            foreach (var c in PartyCharacters.Where(c => c.CharacterId != CharacterId))
                list.Add(new($"char_{c.CharacterId}", $"{c.Name} ({c.PlayerName})", c.CharacterId, null));
            return list;
        }
    }

    // ── State ─────────────────────────────────────────────────────────────────

    private List<InventoryItemDto> items = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    // Item modal — single flat form object mirrors SaveInventoryItemDto
    private bool showItemModal = false;
    private InventoryItemDto? editingItem;
    private SaveInventoryItemDto form = new();

    // Transfer modal
    private bool showTransferModal = false;
    private InventoryItemDto? transferItem;
    private int transferQuantity = 1;
    private string selectedDestinationKey = "";

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync() => await LoadItems();

    public async Task LoadItems()
    {
        isLoading = true;
        try
        {
            if (CharacterId.HasValue)
                items = await InventoryService.GetCharacterInventoryAsync(CharacterId.Value);
            else if (CampaignId.HasValue)
                items = await InventoryService.GetCampaignInventoryAsync(CampaignId.Value);
        }
        finally { isLoading = false; }
    }

    // ── Add / Edit ────────────────────────────────────────────────────────────

    private void ShowAddModal()
    {
        editingItem = null;
        form = new SaveInventoryItemDto { Quantity = 1, DamageDiceCount = 1, DamageDiceSides = 6, ReachFt = 5, BaseArmorClass = 10 };
        showItemModal = true;
    }

    private void ShowEditModal(InventoryItemDto item)
    {
        editingItem = item;
        form = new SaveInventoryItemDto
        {
            ItemType = item.ItemType,
            Name = item.Name,
            Description = item.Description,
            Category = item.Category,
            Quantity = item.Quantity,
            Weight = item.Weight,
            Value = item.Value,
            IsEquipped = item.IsEquipped,
            // Weapon
            AttackType = item.AttackType,
            AbilityUsed = item.AbilityUsed,
            DamageDiceCount = item.DamageDiceCount ?? 1,
            DamageDiceSides = item.DamageDiceSides ?? 6,
            DamageBonus = item.DamageBonus ?? 0,
            DamageType = item.DamageType,
            VersatileDiceCount = item.VersatileDiceCount,
            VersatileDiceSides = item.VersatileDiceSides,
            ReachFt = item.ReachFt ?? 5,
            RangeNormalFt = item.RangeNormalFt,
            RangeLongFt = item.RangeLongFt,
            IsTwoHanded = item.IsTwoHanded,
            IsLight = item.IsLight,
            IsThrown = item.IsThrown,
            Properties = item.Properties,
            // Armor
            ArmorType = item.ArmorType,
            BaseArmorClass = item.BaseArmorClass ?? 10,
            MaxDexBonus = item.MaxDexBonus,
            StrengthRequirement = item.StrengthRequirement,
            StealthDisadvantage = item.StealthDisadvantage,
            ArmorClassBonus = item.ArmorClassBonus ?? 0,
            // Magic
            Rarity = item.Rarity,
            RequiresAttunement = item.RequiresAttunement,
            IsAttuned = item.IsAttuned,
            MaxCharges = item.MaxCharges,
            CurrentCharges = item.CurrentCharges,
            Effect = item.Effect,
            // Potion
            Duration = item.Duration,
            HealDiceCount = item.HealDiceCount,
            HealDiceSides = item.HealDiceSides,
            HealBonus = item.HealBonus,
            // Ammo
            AmmunitionType = item.AmmunitionType,
            DamageBonusOverride = item.DamageBonusOverride,
            // Tool
            ToolType = item.ToolType,
            HasProficiency = item.HasProficiency,
            AssociatedSkill = item.AssociatedSkill,
            // Mount
            SpeedFt = item.SpeedFt,
            CarryingCapacity = item.CarryingCapacity,
            MountType = item.MountType
        };
        showItemModal = true;
    }

    private void CloseItemModal() => showItemModal = false;

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(form.Name)) return;

        isSaving = true;
        errorMessage = null;
        try
        {
            if (editingItem == null)
            {
                form.CharacterId = CharacterId;
                form.CampaignId = CharacterId == null ? CampaignId : null;
                var created = await InventoryService.CreateItemAsync(form);
                if (created != null) items.Add(created);
            }
            else
            {
                var updated = await InventoryService.UpdateItemAsync(editingItem.InventoryItemId, form);
                if (updated != null)
                {
                    var idx = items.FindIndex(i => i.InventoryItemId == updated.InventoryItemId);
                    if (idx >= 0) items[idx] = updated;
                }
            }
            CloseItemModal();
        }
        catch (Exception ex) { errorMessage = $"Error saving item: {ex.Message}"; }
        finally { isSaving = false; }
    }

    // ── Delete ────────────────────────────────────────────────────────────────

    private async Task DeleteItem(InventoryItemDto item)
    {
        errorMessage = null;
        var success = await InventoryService.DeleteItemAsync(item.InventoryItemId);
        if (success) items.Remove(item);
        else errorMessage = "Failed to delete item.";
    }

    // ── Weapon rolls ──────────────────────────────────────────────────────────

    private async Task RollWeaponAttack(InventoryItemDto weapon)
    {
        if (character == null) return;

        // Resolve ability modifier
        var ability = weapon.AbilityUsed ?? WeaponAbility.STR;
        int abilityScore = ability == WeaponAbility.DEX
            ? character.Dexterity
            : ability == WeaponAbility.STRorDEX
                ? Math.Max(character.Strength, character.Dexterity)
                : character.Strength;

        int abilityMod = (abilityScore - 10) / 2;
        int profBonus = character.GetProficiencyBonus();
        int attackMod = abilityMod + profBonus + (weapon.DamageBonus ?? 0);

        // Attack roll (d20)
        var attackRoll = DiceService.AttackRoll(attackMod);
        attackRoll.RollType = $"Attack – {weapon.Name}";
        await OnRoll.InvokeAsync(attackRoll);

        // Damage roll
        var diceType = (weapon.DamageDiceSides ?? 6) switch
        {
            4 => DiceType.D4,
            8 => DiceType.D8,
            10 => DiceType.D10,
            12 => DiceType.D12,
            20 => DiceType.D20,
            _ => DiceType.D6
        };
        int dmgMod = abilityMod + (weapon.DamageBonus ?? 0);
        var dmgRoll = DiceService.DamageRoll(weapon.DamageDiceCount ?? 1, diceType, dmgMod);
        dmgRoll.RollType = $"Damage – {weapon.Name} ({weapon.DamageType})";
        await OnRoll.InvokeAsync(dmgRoll);
    }

