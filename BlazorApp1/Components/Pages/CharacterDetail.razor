@page "/characters/{CharacterId:int}"
@rendermode InteractiveServer
@using BlazorApp1.Components.Shared
@using BlazorApp1.DTOs
@using BlazorApp1.Models
@using BlazorApp1.Services
@using Microsoft.AspNetCore.Authorization
@inject CampaignService CampaignService
@inject CharacterService CharacterService
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject DiceService DiceService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>@(character?.Name ?? "Character")</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (character == null)
    {
        <div class="alert alert-danger">Character not found.</div>
    }
    else
    {
        <div class="mb-4">
            <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back to Campaign
            </button>

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>@character.Name</h1>
                    <p class="lead">
                        @character.Race
                        @string.Join(" / ", character.Classes.Select(c => $"{c.Name} {c.Level}"))
                    </p>
                    <p class="text-muted">
                        <i class="bi bi-person"></i> Player: @character.PlayerName |
                        <i class="bi bi-map"></i> Campaign: @character.CampaignName |
                        <strong>Proficiency Bonus: +@character.GetProficiencyBonus()</strong>
                    </p>
                </div>
                <div>
                    <span class="badge bg-primary" style="font-size: 1.5rem;">Level @character.TotalLevel</span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Ability Scores</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4 mb-3">
                                <div class="border rounded p-2 clickable" @onclick="@(() => RollAbilityCheck(character.Strength))">
                                    <div class="fw-bold">STR</div>
                                    <div class="display-6">@character.Strength</div>
                                    <div class="text-muted small">@GetModifier(character.Strength)</div>
                                </div>
                            </div>
                            <div class="col-4 mb-3">
                                <div class="border rounded p-2 clickable" @onclick="@(() => RollAbilityCheck(character.Dexterity))">
                                    <div class="fw-bold">DEX</div>
                                    <div class="display-6">@character.Dexterity</div>
                                    <div class="text-muted small">@GetModifier(character.Dexterity)</div>
                                </div>
                            </div>
                            <div class="col-4 mb-3">
                                <div class="border rounded p-2 clickable" @onclick="@(() => RollAbilityCheck(character.Constitution))">
                                    <div class="fw-bold">CON</div>
                                    <div class="display-6">@character.Constitution</div>
                                    <div class="text-muted small">@GetModifier(character.Constitution)</div>
                                </div>
                            </div>
                            <div class="col-4 mb-3">
                                <div class="border rounded p-2 clickable" @onclick="@(() => RollAbilityCheck(character.Intelligence))">
                                    <div class="fw-bold">INT</div>
                                    <div class="display-6">@character.Intelligence</div>
                                    <div class="text-muted small">@GetModifier(character.Intelligence)</div>
                                </div>
                            </div>
                            <div class="col-4 mb-3">
                                <div class="border rounded p-2 clickable" @onclick="@(() => RollAbilityCheck(character.Wisdom))">
                                    <div class="fw-bold">WIS</div>
                                    <div class="display-6">@character.Wisdom</div>
                                    <div class="text-muted small">@GetModifier(character.Wisdom)</div>
                                </div>
                            </div>
                            <div class="col-4 mb-3">
                                <div class="border rounded p-2 clickable" @onclick="@(() => RollAbilityCheck(character.Charisma))">
                                    <div class="fw-bold">CHA</div>
                                    <div class="display-6">@character.Charisma</div>
                                    <div class="text-muted small">@GetModifier(character.Charisma)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Last Roll</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (lastRoll != null)
                        {
                            <div class="mb-2"><strong>@lastRoll.RollType</strong></div>
                            <div class="display-4">@lastRoll.FinalTotal</div>
                            <span class="text-muted">(@string.Join(", ", lastRoll.Results)) @(lastRoll.Modifier >= 0 ? "+" : "") @lastRoll.Modifier</span>
                        }
                        else
                        {
                            <span class="text-muted">No Roll</span>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Classes</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            @foreach (var characterClass in character.Classes)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@characterClass.Name</span>
                                    <span class="badge bg-secondary">Level @characterClass.Level</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Skills</h5>
                        <small class="text-muted">Click to roll skill check</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var skill in GetSkillsForDisplay())
                            {
                                var abilityMod = character.GetAbilityModifier(skill.AbilityScore);
                                var profBonus = character.GetProficiencyBonus();
                                var totalMod = abilityMod + (skill.IsProficient ? (skill.HasExpertise ? profBonus * 2 : profBonus) : 0);

                                <div class="list-group-item list-group-item-action clickable py-2" @onclick="@(() => RollSkillCheck(skill))">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            @if (skill.HasExpertise)
                                            {
                                                <i class="bi bi-star-fill text-warning me-2" title="Expertise"></i>
                                            }
                                            else if (skill.IsProficient)
                                            {
                                                <i class="bi bi-circle-fill text-primary me-2" title="Proficient" style="font-size: 0.6rem;"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-circle text-muted me-2" title="Not Proficient" style="font-size: 0.6rem;"></i>
                                            }
                                            <div>
                                                <strong>@skill.Name</strong>
                                                <small class="text-muted ms-1">(@skill.AbilityScore)</small>
                                            </div>
                                        </div>
                                        <span class="badge @(totalMod >= 0 ? "bg-success" : "bg-danger")">
                                            @(totalMod >= 0 ? "+" : "")@totalMod
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Combat Stats</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <div class="text-center border rounded p-3">
                                    <div class="text-muted small">Armor Class</div>
                                    <div class="display-4">@character.ArmorClass</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center border rounded p-3">
                                    <div class="text-muted small">Hit Points</div>
                                    <div class="display-6">
                                        <span class="@(character.CurrentHitPoints <= character.MaxHitPoints / 4 ? "text-danger" : "")">
                                            @character.CurrentHitPoints
                                        </span> / @character.MaxHitPoints
                                    </div>
                                    <div class="progress mt-2" style="height: 10px;">
                                        <div class="progress-bar @(character.CurrentHitPoints <= character.MaxHitPoints / 4 ? "bg-danger" : "bg-success")"
                                             role="progressbar"
                                             style="width: @((double)character.CurrentHitPoints / character.MaxHitPoints * 100)%">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Experience</h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center">
                            <div class="display-6">@character.ExperiencePoints XP</div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5>Actions</h5>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <button class="btn btn-primary" @onclick="EditCharacter">
                            <i class="bi bi-pencil"></i> Edit Character
                        </button>
                        <button class="btn btn-secondary" @onclick="ToggleSkillProficiency">
                            <i class="bi bi-clipboard-check"></i> Manage Skills
                        </button>
                        <button class="btn btn-danger" @onclick="DeleteCharacter">
                            <i class="bi bi-trash"></i> Delete Character
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-bag"></i> Inventory</h5>
                        </div>
                        <div class="card-body">
                            <InventoryPanel CharacterId="@character.CharacterId"
                                            CampaignId="@character.CampaignId"
                                            PartyCharacters="@partyCharacters"
                                            OnTransferred="EventCallback.Empty" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (showSkillManager)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Manage Skill Proficiencies</h5>
                            <button type="button" class="btn-close" @onclick="ToggleSkillProficiency"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">Click on a skill to toggle proficiency. Double-click for expertise.</p>
                            <div class="list-group">
                                @foreach (var skill in GetSkillsForDisplay())
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@skill.Name</strong>
                                                <small class="text-muted ms-1">(@skill.AbilityScore)</small>
                                            </div>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn @(skill.IsProficient == false ? "btn-secondary" : "btn-outline-secondary")"
                                                        @onclick="@(() => SetSkillProficiency(skill, false, false))">
                                                    None
                                                </button>
                                                <button class="btn @(skill.IsProficient && !skill.HasExpertise ? "btn-primary" : "btn-outline-primary")"
                                                        @onclick="@(() => SetSkillProficiency(skill, true, false))">
                                                    Proficient
                                                </button>
                                                <button class="btn @(skill.HasExpertise ? "btn-warning" : "btn-outline-warning")"
                                                        @onclick="@(() => SetSkillProficiency(skill, true, true))">
                                                    Expertise
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="ToggleSkillProficiency">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        }
    }
</div>

<style>
    .clickable {
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .clickable:hover {
            background-color: #f8f9fa;
        }

    .list-group-item-action.clickable:hover {
        background-color: #e9ecef;
    }
</style>

@code {
    [Parameter]
    public int CharacterId { get; set; }

    private CharacterDto? character;
    private bool isLoading = true;
    private DiceRoll? lastRoll;
    private bool showSkillManager = false;
    private List<CharacterDto> partyCharacters = new();


    //private List<InventoryItemDto> campaignInventoryItems = new();


    protected override async Task OnInitializedAsync()
    {
        await LoadCharacter();
        var campaign = await CampaignService.GetCampaignAsync(character.CampaignId);
        partyCharacters = campaign?.Characters ?? new();
        EnsureSkillsInitialized();
    }

    private async Task LoadCharacter()
    {
        isLoading = true;
        try
        {
            character = await CharacterService.GetCharacterAsync(CharacterId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EnsureSkillsInitialized()
    {
        if (character != null && (character.Skills == null || character.Skills.Count == 0))
        {
            character.Skills = SkillDefinitions.GetAllSkills();
        }
    }

    private List<Skill> GetSkillsForDisplay()
    {
        if (character?.Skills == null || character.Skills.Count == 0)
        {
            return SkillDefinitions.GetAllSkills();
        }
        return character.Skills.OrderBy(s => s.Name).ToList();
    }

    private string GetModifier(int abilityScore)
    {
        int modifier = (abilityScore - 10) / 2;
        return modifier >= 0 ? $"+{modifier}" : modifier.ToString();
    }

    private void RollAbilityCheck(int abilityScore)
    {
        int modifier = (abilityScore - 10) / 2;
        lastRoll = DiceService.SkillCheck(modifier);
        lastRoll.RollType = "Ability Check";
    }

    private void RollSkillCheck(Skill skill)
    {
        if (character == null) return;

        int abilityMod = character.GetAbilityModifier(skill.AbilityScore);
        int profBonus = character.GetProficiencyBonus();
        int totalMod = abilityMod;

        if (skill.IsProficient)
        {
            totalMod += skill.HasExpertise ? profBonus * 2 : profBonus;
        }

        lastRoll = DiceService.SkillCheck(totalMod);
        lastRoll.RollType = $"{skill.Name} Check";
    }

    private void ToggleSkillProficiency()
    {
        showSkillManager = !showSkillManager;
    }

    private void SetSkillProficiency(Skill skill, bool proficient, bool expertise)
    {
        skill.IsProficient = proficient;
        skill.HasExpertise = expertise;
        StateHasChanged();
    }

    private void GoBack()
    {
        if (character != null)
        {
            Navigation.NavigateTo($"/campaigns/{character.CampaignId}");
        }
        else
        {
            Navigation.NavigateTo("/campaigns");
        }
    }

    private void EditCharacter()
    {
        Navigation.NavigateTo($"/characters/{CharacterId}/edit");
    }

    private async Task DeleteCharacter()
    {
        if (character == null)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {character.Name}?");
        if (confirmed)
        {
            await CharacterService.DeleteCharacterAsync(CharacterId);
            Navigation.NavigateTo($"/campaigns/{character.CampaignId}");
        }
    }
}
