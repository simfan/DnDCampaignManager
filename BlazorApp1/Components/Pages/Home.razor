    private async Task ConnectToRollHub()
    {
        rollHubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/rollhub"))
            .WithAutomaticReconnect()
            .Build();

        rollHubConnection.On<DiceRoll>("ReceiveRoll", (roll) =>
        {
            rollHistory.Insert(0, roll);
            if (rollHistory.Count > 10)
                rollHistory.RemoveAt(rollHistory.Count - 1);
            InvokeAsync(StateHasChanged);
        });

        await rollHubConnection.StartAsync();
    }

    private string GetRollTypeColor(string rollType) => rollType switch
    {
        "Skill Check" => "text-primary",
        "Saving Throw" => "text-success",
        "Attack Roll" => "text-danger",
        "Initiative" => "text-warning",
        "Damage Roll" => "text-info",
        _ => "text-secondary"
    };

    private string GetRollResultClass(DiceRoll roll)
    {
        if (IsCrit(roll)) return "text-success";
        if (IsFumble(roll)) return "text-danger";
        return "";
    }

    private bool IsCrit(DiceRoll roll) =>
        roll.Results?.Count == 1 && roll.Results[0] == 20;

    private bool IsFumble(DiceRoll roll) =>
        roll.Results?.Count == 1 && roll.Results[0] == 1;
}
