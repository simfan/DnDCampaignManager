@using BlazorApp1.Models
@using BlazorApp1.Services
@inject DiceService DiceService

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-dice-5"></i> Dice Roller</h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Roll Type</label>
            <select class="form-select" @bind="selectedRollType">
                <option value="@RollType.SkillCheck">Skill Check</option>
                <option value="@RollType.SavingThrow">Saving Throw</option>
                <option value="@RollType.AttackRoll">Attack Roll</option>
                <option value="@RollType.DamageRoll">Damage Roll</option>
                <option value="@RollType.Initiative">Initiative</option>
                <option value="@RollType.Custom">Custom</option>
            </select>
        </div>

        @if (selectedRollType == RollType.Custom)
        {
            <div class="row mb-3">
                <div class="col-4">
                    <label class="form-label">Number of Dice</label>
                    <input type="number" class="form-control" @bind="numberOfDice" min="1" max="20" />
                </div>
                <div class="col-4">
                    <label class="form-label">Dice Type</label>
                    <select class="form-select" @bind="selectedDiceType">
                        <option value="@DiceType.D4">d4</option>
                        <option value="@DiceType.D6">d6</option>
                        <option value="@DiceType.D8">d8</option>
                        <option value="@DiceType.D10">d10</option>
                        <option value="@DiceType.D12">d12</option>
                        <option value="@DiceType.D20">d20</option>
                        <option value="@DiceType.D100">d100</option>
                    </select>
                </div>
                <div class="col-4">
                    <label class="form-label">Modifier</label>
                    <input type="number" class="form-control" @bind="modifier" />
                </div>
            </div>
        }
        else if (selectedRollType == RollType.DamageRoll)
        {
            <div class="row mb-3">
                <div class="col-4">
                    <label class="form-label">Number of Dice</label>
                    <input type="number" class="form-control" @bind="numberOfDice" min="1" max="20" />
                </div>
                <div class="col-4">
                    <label class="form-label">Dice Type</label>
                    <select class="form-select" @bind="selectedDiceType">
                        <option value="@DiceType.D4">d4</option>
                        <option value="@DiceType.D6">d6</option>
                        <option value="@DiceType.D8">d8</option>
                        <option value="@DiceType.D10">d10</option>
                        <option value="@DiceType.D12">d12</option>
                    </select>
                </div>
                <div class="col-4">
                    <label class="form-label">Modifier</label>
                    <input type="number" class="form-control" @bind="modifier" />
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Modifier</label>
                <input type="number" class="form-control" @bind="modifier" />
            </div>

            @if (selectedRollType != RollType.Initiative)
            {
                <div class="mb-3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" @bind="advantage" id="advantage" disabled="@disadvantage">
                        <label class="form-check-label" for="advantage">Advantage</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" @bind="disadvantage" id="disadvantage" disabled="@advantage">
                        <label class="form-check-label" for="disadvantage">Disadvantage</label>
                    </div>
                </div>
            }
        }

        <div class="d-grid">
            <button class="btn btn-primary" @onclick="PerformRoll">
                <i class="bi bi-dice-5"></i> Roll!
            </button>
        </div>

        @if (rollHistory.Any())
        {
            <hr />
            <h6>Roll History</h6>
            <div class="list-group" style="max-height: 300px; overflow-y: auto;">
                @foreach (var roll in rollHistory.OrderByDescending(r => r.Timestamp).Take(10))
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@roll.RollType</strong>
                                <br />
                                <small class="text-muted">@roll.DiceNotation</small>
                            </div>
                            <div class="text-end">
                                <div class="badge bg-secondary">
                                    @string.Join(", ", roll.Results)
                                </div>
                                <div class="display-6 @(roll.Results.Contains(20) && roll.Results.Count == 1 ? "text-success" : roll.Results.Contains(1) && roll.Results.Count == 1 ? "text-danger" : "")">
                                    @roll.FinalTotal
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private RollType selectedRollType = RollType.SkillCheck;
    private DiceType selectedDiceType = DiceType.D20;
    private int numberOfDice = 1;
    private int modifier = 0;
    private bool advantage = false;
    private bool disadvantage = false;

    private List<DiceRoll> rollHistory = new();

    private void PerformRoll()
    {
        DiceRoll result = selectedRollType switch
        {
            RollType.SkillCheck => DiceService.SkillCheck(modifier, advantage, disadvantage),
            RollType.SavingThrow => DiceService.SavingThrow(modifier, advantage, disadvantage),
            RollType.AttackRoll => DiceService.AttackRoll(modifier, advantage, disadvantage),
            RollType.Initiative => DiceService.Initiative(modifier),
            RollType.DamageRoll => DiceService.DamageRoll(numberOfDice, selectedDiceType, modifier),
            RollType.Custom => DiceService.Roll(numberOfDice, selectedDiceType, modifier, "Custom Roll"),
            _ => DiceService.Roll(1, DiceType.D20, 0, "Unknown")
        };

        rollHistory.Add(result);
    }
}