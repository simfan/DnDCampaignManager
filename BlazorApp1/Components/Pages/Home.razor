@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using BlazorApp1.DTOs
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject CampaignService CampaignService
@inject CharacterService CharacterService
@inject ResourceService ResourceService
@inject IJSRuntime JS
@inject PlayerEventService EventService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Player Hub</PageTitle>

<div class="container-fluid mt-4">
    <div class="mb-4">
        <h1>Player Hub</h1>
        <p class="text-muted">Welcome back! Here's an overview of your campaigns, events, and characters.</p>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left Column: Campaigns and Characters -->
            <div class="col-lg-6">
                <!-- Campaigns Section -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-map"></i> My Campaigns
                        </h5>
                        <button class="btn btn-sm btn-primary" @onclick='() => Navigation.NavigateTo("/campaigns")'>
                            View All
                        </button>
                    </div>
                    <div class="card-body">
                        @if (campaigns.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-map" style="font-size: 3rem;"></i>
                                <p class="mt-2">No campaigns yet</p>
                                <button class="btn btn-outline-primary btn-sm" @onclick='() => Navigation.NavigateTo("/campaigns")'>
                                    Create Your First Campaign
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var campaign in campaigns.Take(5))
                                {
                                    <div class="list-group-item list-group-item-action"
                                         style="cursor: pointer;"
                                         @onclick='() => Navigation.NavigateTo($"/campaigns/{campaign.CampaignId}")'>
                                        <div class="d-flex w-100 justify-content-between align-items-center">
                                            <h6 class="mb-1">@campaign.Name</h6>
                                            @if (!campaign.IsActive)
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </div>
                                        <p class="mb-1 small text-muted">@campaign.Description</p>
                                        <small class="text-muted">
                                            <i class="bi bi-people"></i> @campaign.MemberCount members •
                                            <i class="bi bi-person"></i> @campaign.CharacterCount characters
                                        </small>
                                    </div>
                                }
                                @if (campaigns.Count > 5)
                                {
                                    <div class="list-group-item text-center">
                                        <small class="text-muted">+@(campaigns.Count - 5) more campaigns</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Characters Section (Moved under Campaigns) -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-person-badge"></i> My Characters
                        </h5>
                        <button class="btn btn-sm btn-primary" @onclick='() => Navigation.NavigateTo("/characters/create")'>
                            Create New
                        </button>
                    </div>
                    <div class="card-body">
                        @if (characters.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-person-badge" style="font-size: 3rem;"></i>
                                <p class="mt-2">No characters yet</p>
                                <button class="btn btn-outline-primary btn-sm" @onclick='() => Navigation.NavigateTo("/characters/create")'>
                                    Create Your First Character
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var character in characters.Take(5))
                                {
                                    <div class="list-group-item list-group-item-action"
                                         style="cursor: pointer;"
                                         @onclick='() => Navigation.NavigateTo($"/characters/{character.CharacterId}")'>
                                        <div class="d-flex w-100 justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">@character.Name</h6>
                                                <p class="mb-0 small text-muted">
                                                    @character.Race @string.Join(" / ", character.Classes.Select(c => $"{c.Name} {c.Level}"))
                                                </p>
                                            </div>
                                            <span class="badge bg-primary">Level @character.TotalLevel</span>
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-map"></i> @character.CampaignName
                                        </small>
                                    </div>
                                }
                                @if (characters.Count > 5)
                                {
                                    <div class="list-group-item text-center">
                                        <small class="text-muted">+@(characters.Count - 5) more characters</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Calendar & Events Section -->
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-event"></i> Calendar & Events
                        </h5>
                        <div class="d-flex align-items-center gap-1">
                            <!-- Export Dropdown (Blazor-managed, no Bootstrap JS dependency) -->
                            <div class="position-relative">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="ToggleExportMenu"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-download"></i> Export <i class="bi bi-caret-down-fill" style="font-size: 0.65rem;"></i>
                                </button>
                                @if (showExportMenu)
                                {
                                    <ul class="dropdown-menu show position-absolute" style="right: 0; top: 100%; z-index: 1050; min-width: 180px;">
                                        <li>
                                            <a class="dropdown-item" href="#" @onclick="ExportUpcomingEventsAndClose" @onclick:preventDefault>
                                                <i class="bi bi-calendar-plus"></i> Upcoming Events
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="#" @onclick="ExportAllEventsAndClose" @onclick:preventDefault>
                                                <i class="bi bi-calendar-check"></i> All Events
                                            </a>
                                        </li>
                                    </ul>
                                }
                            </div>
                            <!-- Navigation Buttons -->
                            <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousMonth" title="Previous month">
                                <i class="bi bi-arrow-left"></i>Last
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="NextMonth" title="Next month">
                                <i class="bi bi-arrow-right"></i>Next
                            </button>
                            <button class="btn btn-sm btn-primary" @onclick="ShowAddEventModal">
                                <i class="bi bi-plus-circle"></i> Add Event
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="text-center mb-3">@currentDate.ToString("MMMM yyyy")</h6>

                        <!-- Calendar Grid -->
                        <div class="calendar-grid mb-3">
                            <!-- Day Headers -->
                            <div class="calendar-day-header">Sun</div>
                            <div class="calendar-day-header">Mon</div>
                            <div class="calendar-day-header">Tue</div>
                            <div class="calendar-day-header">Wed</div>
                            <div class="calendar-day-header">Thu</div>
                            <div class="calendar-day-header">Fri</div>
                            <div class="calendar-day-header">Sat</div>

                            <!-- Calendar Days -->
                            @foreach (var day in GetCalendarDays())
                            {
                                <div class="calendar-day @GetDayClass(day)" @onclick="() => SelectDay(day)">
                                    <div class="day-number">@(day.HasValue? day.Value.Day.ToString() : "")</div>
                                    @if (day.HasValue && HasEvent(day.Value))
                                    {
                                        <div class="event-indicator"></div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Events List for Selected Date -->
                        @if (selectedDate.HasValue)
                        {
                            var dayEvents = GetEventsForDay(selectedDate.Value);
                            <div class="mt-3">
                                <h6 class="border-top pt-3">Events for @selectedDate.Value.ToString("MMMM dd, yyyy")</h6>
                                @if (dayEvents.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var evt in dayEvents)
                                        {
                                            <div class="list-group-item">
                                                <div class="d-flex w-100 justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="mb-1">@evt.Title</h6>
                                                        @if (!string.IsNullOrEmpty(evt.Description))
                                                        {
                                                            <p class="mb-1 small">@evt.Description</p>
                                                        }
                                                        @if (evt.StartTime.HasValue)
                                                        {
                                                            <small class="text-muted">
                                                                <i class="bi bi-clock"></i>
                                                                @evt.StartTime.Value.ToString(@"hh\:mm")
                                                                @if (evt.EndTime.HasValue)
                                                                {
                                                                    <text> - @evt.EndTime.Value.ToString(@"hh\:mm")</text>
                                                                }
                                                            </small>
                                                        }
                                                        @if (!string.IsNullOrEmpty(evt.CampaignName))
                                                        {
                                                            <br />
                                                            <small class="text-muted">
                                                                <i class="bi bi-map"></i> @evt.CampaignName
                                                            </small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small">No events scheduled for this day.</p>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div>Upcoming Events:</div>
                @{
                    var upcomingEvents = events
                    .Where(e => e.EventDate >= DateTime.Today)
                    .OrderBy(e => e.EventDate)
                    .ThenBy(e => e.StartTime)
                    .Take(3)
                    .ToList();
                }
                @if (upcomingEvents.Any())
                {
                    @foreach (var myEvent in upcomingEvents)
                    {
                        <div class="card mb-3 border-start border-4 @GetEventBorderColor(myEvent)">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">
                                            <strong>@myEvent.EventDate.ToString("MM/dd/yyyy")</strong>
                                            @if (myEvent.EventDate.Date == DateTime.Today)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">Today</span>
                                            }
                                            else if (myEvent.EventDate.Date == DateTime.Today.AddDays(1))
                                            {
                                                <span class="badge bg-info ms-2">Tomorrow</span>
                                            }
                                        </h6>
                                        <div class="mb-0">@myEvent.Title</div>
                                        @if (myEvent.CampaignId != null && myEvent.CampaignName != null)
                                        {
                                            <span class="badge bg-primary mt-1"><i class="bi bi-map"></i> @myEvent.CampaignName</span>
                                        }
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary flex-shrink-0 ms-2"
                                            @onclick="() => ExportSingleEvent(myEvent.PlayerEventId, myEvent.Title, myEvent.EventDate)"
                                            title="Export to calendar">Export to Calendar
                                        <i class="bi bi-download"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                        <p class="mb-0 mt-2">No upcoming events scheduled.</p>
                    </div>
                }
            </div>
            <!-- Dice Roll History -->
            <div class="col-12 col-lg-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-dice-5"></i> Roll History
                        </h5>
                        <span class="badge bg-secondary">Live</span>
                    </div>
                    <div class="card-body p-0">
                        @if (rollHistory.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-dice-5" style="font-size: 3rem;"></i>
                                <p class="mt-2">No rolls yet — press a dice button on your Stream Deck!</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var (roll, index) in rollHistory.Select((r, i) => (r, i)))
                                {
                                    <div class="list-group-item @(index == 0 ? "roll-latest" : "")">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="fw-bold @GetRollTypeColor(roll.RollType)">
                                                    @roll.RollType
                                                </span>
                                                <span class="text-muted ms-2 small">@roll.DiceNotation</span>
                                            </div>
                                            <div class="text-end">
                                                <span class="@GetRollResultClass(roll) fs-5 fw-bold">
                                                    @roll.FinalTotal
                                                </span>
                                                @if (roll.Modifier != 0)
                                                {
                                                    <span class="text-muted small ms-1">
                                                        (@(roll.Modifier > 0 ? "+" : "")@roll.Modifier)
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        @if (IsCrit(roll))
                                        {
                                            <span class="badge bg-success">Natural 20!</span>
                                        }
                                        else if (IsFumble(roll))
                                        {
                                            <span class="badge bg-danger">Natural 1</span>
                                        }
                                        <div class="text-muted" style="font-size: 0.7rem;">
                                            @roll.Timestamp.ToLocalTime().ToString("h:mm:ss tt")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Shared Resources Section (Placeholder) -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-book"></i> Shared Resources
                            @if (newResourceCount > 0)
                            {
                                <span class="badge bg-danger ms-2">@newResourceCount new</span>
                            }
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            @if (sharedResources.Count > 0)
                            {
                                <small class="text-muted">@sharedResources.Count resource(s)</small>
                            }
                            <span class="badge @(resourceHubConnected ? "bg-success" : "bg-secondary")" style="font-size:0.65rem;">
                                @(resourceHubConnected ? "Live" : "Offline")
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        @if (resourcesLoading)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                                <span class="ms-2 text-muted small">Loading resources…</span>
                            </div>
                        }
                        else if (sharedResources.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-book" style="font-size:2.5rem;"></i>
                                <p class="mt-2 mb-0">No resources shared with you yet.</p>
                                <small>Resources shared by your DM will appear here instantly.</small>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var res in sharedResources.Take(sharedResourcesExpanded ? sharedResources.Count : 5))
                                {
                                    <div class="list-group-item @(res.IsNew ? "list-group-item-warning" : "")"
                                         style="transition: background-color 2s ease;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                <i class="bi @GetResourceIcon(res.Type) fs-5 text-secondary"></i>
                                                <div>
                                                    <div class="fw-semibold">@res.Name</div>
                                                    @if (!string.IsNullOrWhiteSpace(res.Description))
                                                    {
                                                        <div class="text-muted small">@res.Description</div>
                                                    }
                                                    <div class="text-muted" style="font-size:0.7rem;">
                                                        <i class="bi bi-building"></i> @res.CampaignName
                                                        &nbsp;·&nbsp;
                                                        <i class="bi bi-person"></i> @res.UploadedByName
                                                        &nbsp;·&nbsp;
                                                        <i class="bi bi-calendar"></i> @res.CreatedDate.ToLocalTime().ToString("MMM d")
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-1 ms-2 flex-shrink-0">
                                                @if (res.Type == "Image")
                                                {
                                                    <a href="/api/Resources/file/@res.ResourceId"
                                                       class="btn btn-sm btn-outline-info" target="_blank" title="View">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                }
                                                <a href="/api/Resources/file/@res.ResourceId"
                                                   class="btn btn-sm btn-outline-secondary" download title="Download">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (sharedResources.Count > 5)
                            {
                                <div class="text-center p-2 border-top">
                                    <button class="btn btn-link btn-sm text-decoration-none"
                                            @onclick="() => sharedResourcesExpanded = !sharedResourcesExpanded">
                                        @if (sharedResourcesExpanded)
                                        {
                                            <span><i class="bi bi-chevron-up"></i> Show fewer</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-chevron-down"></i> Show all @sharedResources.Count resources</span>
                                        }
                                    </button>
                                </div>
                            }
                        }
                    </div>
                    </div>
                </div>
            </div>


        <!-- Quick Stats Section -->
        <div class="row g-4 mt-2">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <h2 class="mb-0">@campaigns.Count</h2>
                        <p class="mb-0">Active Campaigns</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <h2 class="mb-0">@characters.Count</h2>
                        <p class="mb-0">Characters</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <h2 class="mb-0">@totalLevel</h2>
                        <p class="mb-0">Combined Levels</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body text-center">
                        <h2 class="mb-0">@events.Count</h2>
                        <p class="mb-0">Upcoming Events</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* Click-outside overlay to close export dropdown *@
@if (showExportMenu)
{
    <div style="position: fixed; inset: 0; z-index: 1040;" @onclick="CloseExportMenu"></div>
}

<style>
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .calendar-day-header {
        text-align: center;
        font-weight: bold;
        padding: 8px;
        background-color: #f8f9fa;
        font-size: 0.875rem;
    }

    .calendar-day {
        aspect-ratio: 1;
        border: 1px solid #dee2e6;
        padding: 4px;
        cursor: pointer;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        transition: background-color 0.2s;
        min-height: 60px;
    }

        .calendar-day:hover {
            background-color: #f8f9fa;
        }

        .calendar-day.today {
            background-color: #e7f3ff;
            border-color: #0d6efd;
            font-weight: bold;
        }

        .calendar-day.selected {
            background-color: #0d6efd;
            color: white;
        }

        .calendar-day.other-month {
            background-color: #f8f9fa;
            color: #adb5bd;
        }

        .calendar-day.has-event {
            border-color: #ffc107;
            border-width: 2px;
        }

    .day-number {
        font-size: 0.875rem;
        margin-bottom: 2px;
    }

    .event-indicator {
        width: 6px;
        height: 6px;
        background-color: #ffc107;
        border-radius: 50%;
        position: absolute;
        bottom: 4px;
    }

    .calendar-day.selected .event-indicator {
        background-color: white;
    }

    .roll-latest {
        background-color: #fff8e1;
        border-left: 4px solid #ffc107 !important;
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private List<CampaignDto> campaigns = new();
    private List<CharacterDto> characters = new();
    private List<PlayerEventDto> events = new();
    private bool isLoading = true;
    private int totalLevel = 0;
    private DateTime currentDate = DateTime.Today;
    private DateTime? selectedDate = null;
    private bool showExportMenu = false;
    private IJSObjectReference? jsModule;
    private HubConnection? rollHubConnection;
    private List<DiceRoll> rollHistory = new();

    // ── Shared Resources state ────────────────────────────────────────────────
    private List<SharedResourceViewModel> sharedResources = new();
    private HubConnection? resourceHubConnection;
    private bool resourceHubConnected = false;
    private bool resourcesLoading = true;
    private bool sharedResourcesExpanded = false;
    private int newResourceCount = 0;
    private class SharedResourceViewModel : ResourceDto
    {
        public bool IsNew{ get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await ConnectToRollHub();
        try
        {
            campaigns = await CampaignService.GetCampaignsAsync();
            characters = await CharacterService.GetCharactersAsync();
            totalLevel = characters.Sum(c => c.TotalLevel);
            await LoadEvents();
            await LoadSharedResources();
            await ConnectToResourceHub();
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/Home.js");
        }
    }

    private async Task LoadEvents()
    {
        events = await EventService.GetEventsByMonthAsync(currentDate.Year, currentDate.Month);
    }
    private async Task LoadSharedResources()
    {
        resourcesLoading = true;
        try
        {
            var all = new List<ResourceDto>();
            foreach (var campaign in campaigns)
            {
                try
                {
                    var res = await ResourceService.GetCampaignResourcesAsync(campaign.CampaignId);
                    if (res != null) all.AddRange(res);
                }
                catch { /* skip campaigns that error */ }
            }

            sharedResources = all
            .OrderByDescending(r => r.CreatedDate)
            .Select(r => new SharedResourceViewModel
            {
                ResourceId = r.ResourceId,
                Name = r.Name,
                Description = r.Description,
                Type = r.Type,
                FileName = r.FileName,
                ContentType = r.ContentType,
                FileSize = r.FileSize,
                CampaignId = r.CampaignId,
                CampaignName = r.CampaignName,
                UploadedById = r.UploadedById,
                UploadedByName = r.UploadedByName,
                CreatedDate = r.CreatedDate,
                LastModifiedDate = r.LastModifiedDate,
                Shares = r.Shares,
                IsNew = false
            })
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading shared resources: {ex.Message}");
        }
        finally
        {
            resourcesLoading = false;
        }
    }

    // ── Connect to ResourceHub ────────────────────────────────────────────────
    private async Task ConnectToResourceHub()
    {
        try
        {
            resourceHubConnection = new HubConnectionBuilder()
               .WithUrl(Navigation.ToAbsoluteUri("/resourcehub"), options =>
    {
        options.UseDefaultCredentials = true;
        options.HttpMessageHandlerFactory = _ => new HttpClientHandler
        {
            UseCookies = false,
            UseDefaultCredentials = true
        };
    })
            .WithAutomaticReconnect()
            .Build();

            // Real-time: a resource was just shared into one of our campaigns
            resourceHubConnection.On<ResourceDto>("ResourceShared", async (dto) =>
            {
                await InvokeAsync(() =>
        {
            // Avoid duplicates (re-share of same resource)
            sharedResources.RemoveAll(r => r.ResourceId == dto.ResourceId);

            var vm = new SharedResourceViewModel
                {
                    ResourceId = dto.ResourceId,
                    Name = dto.Name,
                    Description = dto.Description,
                    Type = dto.Type,
                    FileName = dto.FileName,
                    ContentType = dto.ContentType,
                    FileSize = dto.FileSize,
                    CampaignId = dto.CampaignId,
                    CampaignName = dto.CampaignName,
                    UploadedById = dto.UploadedById,
                    UploadedByName = dto.UploadedByName,
                    CreatedDate = dto.CreatedDate,
                    LastModifiedDate = dto.LastModifiedDate,
                    Shares = dto.Shares,
                    IsNew = true
                };

            sharedResources.Insert(0, vm);
            newResourceCount++;
            StateHasChanged();

            // Fade the highlight out after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ =>
        {
            vm.IsNew = false;
            if (newResourceCount > 0) newResourceCount--;
            InvokeAsync(StateHasChanged);
        });
        });
            });

            resourceHubConnection.Reconnected += async _ =>
            {
                resourceHubConnected = true;
                await JoinResourceHubGroups();
                await InvokeAsync(StateHasChanged);
            };

            resourceHubConnection.Reconnecting += _ =>
            {
                resourceHubConnected = false;
                return InvokeAsync(StateHasChanged);
            };

            await resourceHubConnection.StartAsync();
            resourceHubConnected = true;
            await JoinResourceHubGroups();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ResourceHub connection error: {ex.Message}");
            Console.WriteLine($"ResourceHub inner excpetion: {ex.InnerException?.Message}");
        }
    }

    private async Task JoinResourceHubGroups()
    {
        if (resourceHubConnection?.State != HubConnectionState.Connected) return;
        foreach (var campaign in campaigns)
        {
            await resourceHubConnection.SendAsync("JoinCampaign", campaign.CampaignId.ToString());
        }
    }

