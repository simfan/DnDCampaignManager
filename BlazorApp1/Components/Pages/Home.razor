    private void SelectDay(DateTime? day)
    {
        if (day.HasValue)
        {
            selectedDate = day.Value;
        }
    }

    private List<DateTime?> GetCalendarDays()
    {
        var firstDayOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);
        var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;

        var days = new List<DateTime?>();

        // Add empty days for previous month
        for (int i = 0; i < startDayOfWeek; i++)
        {
            days.Add(firstDayOfMonth.AddDays(-(startDayOfWeek - i)));
        }

        // Add days of current month
        for (int day = 1; day <= lastDayOfMonth.Day; day++)
        {
            days.Add(new DateTime(currentDate.Year, currentDate.Month, day));
        }

        // Add empty days for next month to complete the grid
        while (days.Count % 7 != 0)
        {
            days.Add(lastDayOfMonth.AddDays(days.Count - startDayOfWeek - lastDayOfMonth.Day + 1));
        }

        return days;
    }

    private string GetDayClass(DateTime? day)
    {
        if (!day.HasValue) return "";

        var classes = new List<string>();

        if (day.Value.Month != currentDate.Month)
            classes.Add("other-month");

        if (day.Value.Date == DateTime.Today)
            classes.Add("today");

        if (selectedDate.HasValue && day.Value.Date == selectedDate.Value.Date)
            classes.Add("selected");

        if (HasEvent(day.Value))
            classes.Add("has-event");

        return string.Join(" ", classes);
    }

    private bool HasEvent(DateTime day)
    {
        return events.Any(e => e.EventDate.Date == day.Date);
    }

    private List<PlayerEventDto> GetEventsForDay(DateTime day)
    {
        return events.Where(e => e.EventDate.Date == day.Date).OrderBy(e => e.StartTime).ToList();
    }

