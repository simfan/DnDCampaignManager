    // The panel needs the character to compute modifiers. Lazy-loaded from PartyCharacters or CharacterId.
    private CharacterDto? character => PartyCharacters.FirstOrDefault(c => c.CharacterId == CharacterId);

    // ── Transfer ──────────────────────────────────────────────────────────────

    private void ShowTransferModal(InventoryItemDto item)
    {
        transferItem = item;
        transferQuantity = item.Quantity;
        selectedDestinationKey = TransferDestinations.Count == 1 ? TransferDestinations[0].Key : "";
        showTransferModal = true;
    }

    private void CloseTransferModal() => showTransferModal = false;

    private async Task DoTransfer()
    {
        if (transferItem == null || string.IsNullOrEmpty(selectedDestinationKey)) return;

        var dest = TransferDestinations.FirstOrDefault(d => d.Key == selectedDestinationKey);
        if (dest == null) return;

        isSaving = true;
        errorMessage = null;
        try
        {
            var dto = new TransferInventoryItemDto
            {
                InventoryItemId = transferItem.InventoryItemId,
                ToCharacterId = dest.ToCharacterId,
                ToCampaignId = dest.ToCampaignId,
                QuantityToTransfer = transferQuantity < transferItem.Quantity ? transferQuantity : null
            };

            var result = await InventoryService.TransferItemAsync(dto);
            if (result != null)
            {
                await LoadItems();
                CloseTransferModal();
                await OnTransferred.InvokeAsync();
            }
            else errorMessage = "Transfer failed.";
        }
        finally { isSaving = false; }
    }

    // ── Display helpers ───────────────────────────────────────────────────────

    private static string ItemTypeIcon(ItemType t) => t switch
    {
        ItemType.Weapon => "bi-sword",
        ItemType.Armor => "bi-shield-fill",
        ItemType.MagicItem => "bi-stars",
        ItemType.Potion => "bi-capsule",
        ItemType.Ammunition => "bi-dot",
        ItemType.Tool => "bi-tools",
        ItemType.Mount => "bi-star",
        _ => "bi-bag"
    };

    private static string ItemSummary(InventoryItemDto i) => i.ItemType switch
    {
        ItemType.Weapon => $"{i.AttackType} · {i.DamageDiceCount}d{i.DamageDiceSides}{(i.DamageBonus > 0 ? $"+{i.DamageBonus}" : i.DamageBonus < 0 ? $"{i.DamageBonus}" : "")} {i.DamageType}"
            + (i.VersatileDiceCount.HasValue ? $" / {i.VersatileDiceCount}d{i.VersatileDiceSides} versatile" : ""),
        ItemType.Armor => $"{i.ArmorType} · AC {i.BaseArmorClass}{(i.ArmorClassBonus > 0 ? $"+{i.ArmorClassBonus}" : "")}{(i.MaxDexBonus.HasValue ? $" (DEX cap +{i.MaxDexBonus})" : "")}"
            + (i.StealthDisadvantage == true ? " · Stealth disadv." : ""),
        ItemType.MagicItem => $"{i.Rarity}{(i.RequiresAttunement == true ? " · Attunement" : "")}{(i.MaxCharges.HasValue ? $" · {i.CurrentCharges}/{i.MaxCharges} charges" : "")}",
        ItemType.Potion => $"{i.Effect}{(i.HealDiceCount.HasValue ? $" · Heal {i.HealDiceCount}d{i.HealDiceSides}{(i.HealBonus > 0 ? $"+{i.HealBonus}" : "")}" : "")}",
        ItemType.Ammunition => $"{i.AmmunitionType}{(i.DamageBonusOverride.HasValue ? $" (+{i.DamageBonusOverride})" : "")}",
        ItemType.Tool => $"{i.ToolType}{(i.HasProficiency == true ? " · Proficient" : "")}",
        ItemType.Mount => $"{i.MountType}{(i.SpeedFt.HasValue ? $" · {i.SpeedFt}ft" : "")}",
        _ => i.Category ?? ""
    };
